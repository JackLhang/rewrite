#!name=腾讯视频去广告
#!desc=过滤腾讯视频客户端广告并精简界面（适配 iOS 9.04.46.25021）：阻断开屏广告、首页feed动画广告卡、个人中心横幅/视频广告、播放贴片/试看广告、激励广告、浮窗活动与 VIP 推广；精简顶部频道与底部 Tab（去除短剧/好物/好片）；清理「我的」页游戏中心、运营推广项与 VIP 营销卡。需开启 MitM 与脚本功能。
#!author=RuCu6 + 9.x 适配
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tencent_Video.png
#!category=BetaPlugin
#!openUrl=https://apps.apple.com/app/id458318329
#!tag=去广告
#!system=ios
#!loon_version=3.5.1(992)
#!homepage=https://hub.kelee.one
#!date=2026-09-15 17:57:03

[Rule]
# 阻断 QUIC(HTTP/3)：否则腾讯视频走 QUIC 会绕过 MitM，脚本与 URL 规则全部失效。
# 全局生效（影响所有 App 的 QUIC），如不想要可删除本行，代价是部分广告可能漏拦。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-DROP
# 开屏广告：video-mobile-tech 子域仅承载冷启动 Splash 配置，整域拦截即可去掉开屏广告
DOMAIN,video-mobile-tech-1258344701.shiply-cdn.qq.com,REJECT
# 原模块广告域名拦截（保留）
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,info4.video.qq.com,REJECT
DOMAIN,info6.video.qq.com,REJECT
DOMAIN,ios.video.mpush.qq.com,REJECT
DOMAIN,otheve.beacon.qq.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,tpns.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,l.qq.com,REJECT
DOMAIN-KEYWORD,trace.qq.com,REJECT
DOMAIN-KEYWORD,trace.video.qq.com,REJECT
IP-CIDR,47.110.187.87/32,REJECT,no-resolve
# 注意：新版播放信息(getvinfo/batchvinfo/checktime)已迁移到 vv6.video.qq.com，
# 因此不再整域名 REJECT vv6.video.qq.com，改由脚本改写请求参数去广告
# 新增：广告 SDK / 归因上报（含 iacc.stgw 子域，日志实测出现）
DOMAIN,iacc.qq.com,REJECT
DOMAIN,iacc.rec.qq.com,REJECT
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,mazu.m.qq.com,REJECT
DOMAIN,tmfmazu.m.qq.com,REJECT
# 旧版广告视频 CDN（兼容保留）
URL-REGEX,^http://[\d\.:]*/?(defaultts\.tc|vmind\.qqvideo\.tc|finderpdd\.video)\.qq\.com/\w+,REJECT
URL-REGEX,^http://apd-vlive\.apdcdn\.tc\.qq\.com/vmind\.qqvideo\.tc\.qq\.com/\w+,REJECT
URL-REGEX,^http://apd-\w+\.v\.smtcdns\.com/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com/\w+,REJECT

[Script]
# 脚本托管于 https://paste.rs/He2T9（内容与仓库内 qqvideo-clean.js 一致；已内置 gzip 自适应与「首次生效通知」）
http-request ^https?:\/\/vv6?\.video\.qq\.com\/(diff|get)vmind script-path=https://paste.rs/He2T9, requires-body=1, binary-body-mode=true, timeout=15
http-request ^https?:\/\/vv6?\.video\.qq\.com\/(getvinfo|batchvinfo) script-path=https://paste.rs/He2T9, requires-body=1, binary-body-mode=true, timeout=15
http-request ^https?:\/\/(i\.video\.qq\.com|iwan\.video\.qq\.com)\/ script-path=https://paste.rs/He2T9, requires-body=1, binary-body-mode=true, timeout=15
http-response ^https?:\/\/i\.video\.qq\.com\/ script-path=https://paste.rs/He2T9, requires-body=1, binary-body-mode=true, timeout=20

[MITM]
hostname = vv.video.qq.com, vv6.video.qq.com, i.video.qq.com, iwan.video.qq.com
