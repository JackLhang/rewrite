#!name=腾讯视频去广告+精简
#!author=TG@ZenMoFiShi（Loon 移植）
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tencent_Video.png
#!openUrl=https://apps.apple.com/app/id458318329
#!tag=去广告
#!system=ios
#!loon_version=3.5.1(983)
#!date=2026-11-12
#!desc=去开屏广告、前贴/中插、暂停广告，去掉底部多余 Tab 与「我的」页广告；插件页有「诊断日志 / 删除底部Tab / Tab方案B」三个开关

# ─────────────────────────────────────────────────────────────
# v1.0.5（2026-11-12）—— 第二次修「底部 Tab 还是去不掉」
#
# 上一版已把延迟修好：新日志里 [Tab] 紧跟在 [入口] 后面（同一毫秒），
# 4590→3537B 的改写每次都在 2ms 内完成，不再是 14 秒后才回写。
# 但客户端仍然显示 5 个 Tab，而且 3 秒内连发了 4 次 getNaviPage
# （15:03:50.6 / 50.9 / 52.1 / 53.7）—— 像是客户端认为「这页没收全」在重试，
# 重试还不行就退回本地默认 Tab。所以这一版把删 Tab 之后所有相关计数一起改掉：
#
# 1) 每条 Tab 的 f2 顺序号 + f22 元数据里的 item_idx 一起重排（上一版只改了 f2）；
# 2) 页面级 sdk_page_ctx 的 page_size 跟着改成剩下的个数（原来还写着 5）；
# 3) 导航版本号（f4）换成「原值前 11 位 + 当前秒数后 9 位」，
# 不再依赖 $persistentStore —— 日志里三次都是 …327→…328，说明 Loon 里
# 跨求值读不回来，客户端每次都收到同一个版本，自然一直用旧缓存；
# 4) 诊断日志新增一行 `[请求] getNaviPage page_id=… data_identifier=…`：
# data_identifier 非空 = 客户端本地已经缓存过这页导航数据（下次排查直接看这行）；
# 5) 脚本源走 jsdelivr（带 7 天缓存），timeout=8。
#
# ★ 如果 jsdelivr 在你这儿打不开，把下面三行里的脚本地址整体换成镜像，例如
# https://ghfast.top/https://raw.githubusercontent.com/JackLhang/rewrite/refs/heads/main/script/QQLiveCleanNew.js
# https://raw.githubusercontent.com/JackLhang/rewrite/refs/heads/main/script/QQLiveCleanNew.js
# ─────────────────────────────────────────────────────────────

[Argument]
diag = switch,true,tag=诊断日志,desc=打开后在 Loon 日志里输出 txvideo-ad-clean 流水（排查用）
tabs = switch,true,tag=删除底部多余Tab,desc=关闭后底部导航保持原样（5 个 Tab），不影响其它去广告功能
tabvip = switch,false,tag=Tab方案B(删VIP会员),desc=开=删「VIP会员/好物」保留短视频；关=删「短剧/好物」保留会员专区

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
# i.video.qq.com 请求侧：拦截开屏、贴片、信息流等广告 RPC
request if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js?v=20261112e", {${diag},${tabs},${tabvip}}) with tag="腾讯视频-广告请求", timeout=8, requires_body=true, binary_body_mode=true
# i.video.qq.com 响应侧：清理 protobuf(tRPC) 内的广告元素与多余 Tab
response if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js?v=20261112e", {${diag},${tabs},${tabvip}}) with tag="腾讯视频-播放页", timeout=8, requires_body=true, binary_body_mode=true
# iacc.qq.com：JCE 二进制，处理播放提示、贴片广告、暂停广告、青少年弹窗
response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js?v=20261112e", {${diag},${tabs},${tabvip}}) with tag="腾讯视频-JCE", timeout=8, requires_body=true, binary_body_mode=true

[MITM]
hostname = i.video.qq.com, iacc.qq.com