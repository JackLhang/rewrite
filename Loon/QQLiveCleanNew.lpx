#!name=腾讯视频去广告+精简
#!author=TG@ZenMoFiShi（Loon 移植）
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tencent_Video.png
#!openUrl=https://apps.apple.com/app/id458318329
#!tag=去广告
#!system=ios
#!loon_version=3.5.1(983)
#!date=2026-11-18 16:10:00
#!desc=去开屏广告、前贴/中插、暂停广告，去掉「我的」页广告；底部 Tab 与首页顶栏购物车精简（无开关，装上即生效）

# ─────────────────────────────────────────────────────────────
# v1.2.4（2026-11-18）—— 无开关版 + 真正生效
#
# ★ 为什么之前「什么都不生效」（设备日志实测，174 次求值里 134 次 timeout）：
# 脚本地址用的是 raw.githubusercontent.com，国内基本拉不下来，Loon 8 秒超时后
# 直接放行原响应 —— 所以 Tab 没精简、购物车没删，不是解析逻辑的问题，
# 是脚本压根没跑起来（日志里 [Tab] 一次都没出现，[i.video] 全是「未命中广告元素」）。
# → 本版把脚本地址换成 jsdelivr（国内可达 + 7 天缓存）。
#
# ★ 本插件**没有任何开关**（[Argument] 段已删除）：
# 诊断日志、底部 Tab 裁剪、Tab 方案全部在脚本里钉死，装上即生效。
# 想改行为请直接改脚本顶部的 DIAG_ON / TAB_ON / TAB_PLAN / CART_MODE 常量。
#
# ★ 改完脚本必须刷 CDN，否则 Loon 还拿旧脚本（浏览器打开一次，看到 "status": "finished"）：
# https://purge.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js
#
# ★ 如果 jsdelivr 打不开，把 [Script] 里五行地址整体换成镜像：
# https://ghfast.top/https://raw.githubusercontent.com/JackLhang/rewrite/refs/heads/main/script/QQLiveCleanNew.js
#
# ⚠️ 底部 Tab 是「收到新列表后先写本地缓存、下次启动才应用」，
# 所以装好/改完脚本后**启动两次**才看得到效果。
# ─────────────────────────────────────────────────────────────

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
# i.video.qq.com 请求侧：拦截开屏、贴片、信息流等广告 RPC；并把 getNaviPage 的
# data_identifier 清空，逼服务端整页下发（购物车/筛选条只在整页里）
request if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js") with tag="腾讯视频-广告请求", timeout=8, requires_body=true, binary_body_mode=true
# i.video.qq.com 响应侧：清理 protobuf(tRPC) 内的广告元素、底部 Tab、顶栏购物车
response if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js") with tag="腾讯视频-播放页", timeout=8, requires_body=true, binary_body_mode=true
# iacc.qq.com：JCE 二进制，处理播放提示、贴片广告、暂停广告、青少年弹窗
response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js") with tag="腾讯视频-JCE", timeout=8, requires_body=true, binary_body_mode=true
# config.ab.qq.com：AB 配置，补 simple_mode_config（底部 Tab 裁剪开关）
response if ${url} ~= /^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig/ then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js") with tag="腾讯视频-AB配置", timeout=8, requires_body=true, binary_body_mode=true
# rdelivery.qq.com：SDK 灰度，关掉 tab_gray
response if ${url} ~= /^https?:\/\/rdelivery\.qq\.com\// then script("https://cdn.jsdelivr.net/gh/JackLhang/rewrite@main/script/QQLiveCleanNew.js") with tag="腾讯视频-SDK灰度", timeout=8, requires_body=true, binary_body_mode=true

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
